{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StarCLX",
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "tel",
          "callto",
          "sip"
        ]
      }
    }
  }
}
